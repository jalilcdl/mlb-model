# Secrets -- never commit. Local dev uses .env; deployed uses platform secrets
# (GitHub Actions repo secrets for the poller, Streamlit Cloud's secrets manager
# for the dashboard).
.env
.streamlit/secrets.toml

# Python
__pycache__/
*.py[cod]
*.egg-info/
.pytest_cache/
venv/
.venv/

# Backtest output -- regenerable by re-running strategy/backtest.py, not
# meant to be versioned (charts/CSVs change every run as the log grows).
strategy/reports/*
!strategy/reports/.gitkeep

# OS noise
.DS_Store
Thumbs.db
desktop.ini
